# Required for iron-session (generate a long random string)
SESSION_SECRET=

# Postgres database (Neon / Vercel Postgres). Required for org-scoped bookmarks.
# Get a free project at https://neon.tech — copy the connection string here.
DATABASE_URL=

# Optional: separate HMAC key for signed “section-only” share links (defaults to SESSION_SECRET if unset)
PRODUCT_SHARE_SECRET=

# Primary demo user (existing flow — unchanged)
AUTH_USERNAME=
# bcrypt hash: use base64 of the bcrypt string (recommended) or a quoted plain $2b$... string
AUTH_PASSWORD_HASH=

# Optional: second user who must choose a commissioning entity before the store (e.g. luda / cris)
# Generate base64 hash: node -e "const b=require('bcryptjs');const h=b.hashSync('YOUR_PASSWORD',10);console.log(Buffer.from(h,'utf8').toString('base64'))"
AUTH_MULTI_USERNAME=
AUTH_MULTI_PASSWORD_HASH=

# AI Advisor panel + chat API. Set to true to enable; omit to hide the feature.
# NEXT_PUBLIC_AI_ADVISOR_ENABLED=true

# Required when AI Advisor is enabled. Get a key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Alpha line (healthstore-alpha / main deploy only): when true, hides the cookie banner and disables Hotjar.
# Leave unset on v1 / prototype deployments.
# NEXT_PUBLIC_ALPHA_LINE=true
